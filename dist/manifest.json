{
  "manifest_version": 3,
  "name": "API Mock Interceptor",
  "version": "1.0.0",
  "description": "Intercept HTTP requests and return fake responses",
  "permissions": ["storage"],
  "host_permissions": [
    "<all_urls>",
    "http://localhost/*",
    "https://localhost/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/interceptor.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "action": {
    "default_popup": "popup/index.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "options/index.html",
    "open_in_tab": true
  }
}
